# Copy this file to .env and fill in your values, then `docker compose up`.

# HuggingFace read-only token. Required for the first-time download of
# LLM2Vec (Meta-gated) used by the text-encoder service. Create a token
# at https://huggingface.co/settings/tokens (Read role is enough).
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Which GPU(s) to expose to the stack. Defaults to GPU 0. Comma-separate
# multiple indices (e.g. "0,1") if you have more than one. Note: LLM2Vec's
# multi-GPU path is unstable, so pin text-encoder to a single index.
GPU_DEVICE=0

# Port for the upstream Kimodo single-clip Viser demo. Our own UI lives on
# port 7870 regardless.
DEMO_PORT=7860
